# ==============================================================================
# Backend & Global Configuration Template (.env)
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Path to trained model artifacts (defaults to 'models' directory in project root)
MODEL_DIR=models

# Supabase Authentication & PostgreSQL Configuration
# Retrieve these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase JWT Secret (Settings -> API -> JWT Settings -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

